{
  "tagEditCases": [
    {
      "name": "preserve unknown keys, order and comments",
      "markdown": "---\ncreated: 2024-01-01\n# a comment\ntags: [\"old\"]\n---\nbody",
      "newTags": ["project", "note"],
      "expected": "---\ncreated: 2024-01-01\n# a comment\ntags: [\"project\", \"note\"]\n---\nbody"
    },
    {
      "name": "add tags when front matter has no tags key",
      "markdown": "---\ncreated: 2024-01-01\n---\nbody",
      "newTags": ["a"],
      "expected": "---\ntags: [\"a\"]\ncreated: 2024-01-01\n---\nbody"
    },
    {
      "name": "add front matter when absent",
      "markdown": "plain body",
      "newTags": ["a"],
      "expected": "---\ntags: [\"a\"]\n---\nplain body"
    },
    {
      "name": "clear tags keeps other keys",
      "markdown": "---\ncreated: 2024\ntags: [\"a\"]\n---\nbody",
      "newTags": [],
      "expected": "---\ncreated: 2024\n---\nbody"
    },
    {
      "name": "clear tags drops an otherwise empty front matter",
      "markdown": "---\ntags: [\"a\"]\n---\nbody",
      "newTags": [],
      "expected": "body"
    },
    {
      "name": "escaped tag values round-trip",
      "markdown": "---\ntags: [\"one,two\", \"say \\\"hi\\\"\", \"a\\\\b\"]\n---\nbody",
      "newTags": ["one,two", "say \"hi\"", "a\\b"],
      "expected": "---\ntags: [\"one,two\", \"say \\\"hi\\\"\", \"a\\\\b\"]\n---\nbody"
    },
    {
      "name": "sequential edits keep unrelated keys",
      "markdown": "---\ncreated: x\n# keep me\ntags: [\"a\"]\n---\nbody",
      "newTags": ["b", "c"],
      "expected": "---\ncreated: x\n# keep me\ntags: [\"b\", \"c\"]\n---\nbody"
    }
  ],
  "errorCases": [
    {
      "name": "block-style tags",
      "markdown": "---\ntags:\n  - a\n---\nbody",
      "newTags": ["x"]
    },
    {
      "name": "duplicate tags keys",
      "markdown": "---\ntags: [\"a\"]\ntags: [\"b\"]\n---\nbody",
      "newTags": ["x"]
    },
    {
      "name": "block scalar tags",
      "markdown": "---\ntags: |\n  a\n---\nbody",
      "newTags": ["x"]
    }
  ]
}
